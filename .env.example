# Database
DATABASE_URL=sqlite:///./adaptivelearn_dev.db

# Public registration accepts any syntactically valid email address.
# Only students can self-register; admin/faculty roles are provisioned by admins.
# Only for an EMPTY development database. Set false in production.
SEED_DEMO_DATA=true

# JWT Authentication
JWT_SECRET=change-this-secret-to-a-very-secure-random-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI Configuration (Phase 3+)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# RAG & Embeddings (Phase 2+)
CHROMA_PERSIST_DIRECTORY=./chroma_data
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173
ENVIRONMENT=development
